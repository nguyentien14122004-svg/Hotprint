<IfModule mod_setenvif.c>
SetEnvIfNoCase Host "^(www\.)?hotprint\.vn(:[0-9]+)?$" hotprint_company=1
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow" env=!hotprint_company
Header always set X-Content-Type-Options "nosniff"
</IfModule>
</IfModule>
