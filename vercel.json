{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/yeu-cau-mau/:path*",
      "destination": "/dat-lich-tu-van/",
      "permanent": true
    },
    {
      "source": "/en/request-a-sample/:path*",
      "destination": "/en/request-a-consultation/",
      "permanent": true
    },
    {
      "source": "/zh/request-a-sample/:path*",
      "destination": "/zh/request-a-consultation/",
      "permanent": true
    }
  ]
}
